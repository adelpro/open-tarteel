# ── Public runtime configuration ─────────────────────────────────────────────
# Canonical public URL of the deployment (no trailing slash).
# In production this must be the real origin; localhost is rejected at build.
NEXT_PUBLIC_APP_URL=https://tarteel.quran.us.kg
NEXT_PUBLIC_APP_NAME=Open Tarteel
NEXT_PUBLIC_APP_VERSION=N/A
# Set to "true" to show verbose errors in the UI. Always "false" in production.
NEXT_PUBLIC_DEBUG=false
# Search Console HTML verification token (optional).
GOOGLE_SITE_VERIFICATION=
# Force noindex on preview/staging builds. Production stays false.
SEO_NOINDEX=false

# Feature flags (default off unless explicitly enabled).
NEXT_PUBLIC_ENABLE_MP3QURAN_V4=false

# ── Server configuration ─────────────────────────────────────────────────────
# Port used by `next start` / the standalone server.
PORT=3000

# ── Feedback email (optional) ────────────────────────────────────────────────
# Leave empty to disable the contact form (the API returns 503).
# Provide either FEED_BACK_SERVICE (e.g. "gmail") or FEED_BACK_HOST + FEED_BACK_PORT.
FEED_BACK_EMAIL=
FEED_BACK_PASSWORD=
FEED_BACK_SERVICE=
FEED_BACK_HOST=
FEED_BACK_PORT=

# ── Itqan CMS API ────────────────────────────────────────────────────────────
# Optional server-only key. Public endpoints work without it, but the key
# raises limits and identifies the app in `X-Itqan-App`.
ITQAN_API_KEY=

# ── Quran Foundation provider ────────────────────────────────────────────────
# OAuth2 client credentials (server-only; never expose the secret to the client).
QURAN_FOUNDATION_CLIENT_ID=
QURAN_FOUNDATION_CLIENT_SECRET=
# Public read-only fallback used when the credentials above are absent.
QURAN_FOUNDATION_PUBLIC_API_BASE=https://api.quran.com/api/v4

# ── MP3Quran v4 beta ────────────────────────────────────────────────────────
# Staging base URL until the v4 API is promoted. Override per environment.
MP3QURAN_V4_BASE_URL=https://api-staging.mp3quran.net/v4
