{"surah":26,"ayahs":[{"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ طسٓمٓ","w":5,"b":4,"r":[["madd_6",40,42],["madd_6",42,44]]},{"t":"تِلْكَ ءَايَٰتُ ٱلْكِتَٰبِ ٱلْمُبِينِ","w":4,"b":0,"r":[["madd_2",12,13],["hamzat_wasl",16,17],["madd_2",23,24],["hamzat_wasl",27,28],["madd_246",34,35]]},{"t":"لَعَلَّكَ بَٰخِعٌ نَّفْسَكَ أَلَّا يَكُونُوا۟ مُؤْمِنِينَ","w":6,"b":0,"r":[["madd_2",12,13],["idghaam_ghunnah",16,21],["silent",43,45],["madd_246",54,55]]},{"t":"إِن نَّشَأْ نُنَزِّلْ عَلَيْهِم مِّنَ ٱلسَّمَآءِ ءَايَةً فَظَلَّتْ أَعْنَٰقُهُمْ لَهَا خَٰضِعِينَ","w":11,"b":0,"r":[["idghaam_ghunnah",2,7],["idghaam_shafawi",30,35],["hamzat_wasl",38,39],["lam_shamsiyyah",39,40],["madd_muttasil",45,47],["ikhfa",56,60],["madd_2",74,75],["madd_2",90,91],["madd_246",95,96]]},{"t":"وَمَا يَأْتِيهِم مِّن ذِكْرٍ مِّنَ ٱلرَّحْمَٰنِ مُحْدَثٍ إِلَّا كَانُوا۟ عَنْهُ مُعْرِضِينَ","w":11,"b":0,"r":[["idghaam_shafawi",15,20],["ikhfa",20,24],["idghaam_ghunnah",27,32],["hamzat_wasl",35,36],["lam_shamsiyyah",36,37],["madd_2",44,45],["silent",70,72],["madd_246",88,89]]},{"t":"فَقَدْ كَذَّبُوا۟ فَسَيَأْتِيهِمْ أَنۢبَٰٓؤُا۟ مَا كَانُوا۟ بِهِۦ يَسْتَهْزِءُونَ","w":8,"b":0,"r":[["qalqalah",4,6],["silent",15,17],["iqlab",37,39],["madd_muttasil",40,42],["silent",44,46],["silent",57,59],["madd_2",64,65],["madd_246",78,79]]},{"t":"أَوَلَمْ يَرَوْا۟ إِلَى ٱلْأَرْضِ كَمْ أَنۢبَتْنَا فِيهَا مِن كُلِّ زَوْجٍ كَرِيمٍ","w":11,"b":0,"r":[["silent",15,17],["hamzat_wasl",24,25],["iqlab",42,44],["ikhfa",60,64],["ikhfa",73,77],["madd_246",79,80]]},{"t":"إِنَّ فِى ذَٰلِكَ لَءَايَةً وَمَا كَانَ أَكْثَرُهُم مُّؤْمِنِينَ","w":8,"b":0,"r":[["ghunnah",2,5],["madd_2",12,13],["idghaam_ghunnah",26,30],["idghaam_shafawi",50,55],["madd_246",61,62]]},{"t":"وَإِنَّ رَبَّكَ لَهُوَ ٱلْعَزِيزُ ٱلرَّحِيمُ","w":5,"b":0,"r":[["ghunnah",4,7],["hamzat_wasl",23,24],["hamzat_wasl",34,35],["lam_shamsiyyah",35,36],["madd_246",41,42]]},{"t":"وَإِذْ نَادَىٰ رَبُّكَ مُوسَىٰٓ أَنِ ٱئْتِ ٱلْقَوْمَ ٱلظَّٰلِمِينَ","w":8,"b":0,"r":[["madd_munfasil",2