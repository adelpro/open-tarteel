{"surah":99,"ayahs":[{"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِذَا زُلْزِلَتِ ٱلْأَرْضُ زِلْزَالَهَا","w":8,"b":4,"r":[["hamzat_wasl",56,57]]},{"t":"وَأَخْرَجَتِ ٱلْأَرْضُ أَثْقَالَهَا","w":3,"b":0,"r":[["hamzat_wasl",13,14]]},{"t":"وَقَالَ ٱلْإِنسَٰنُ مَا لَهَا","w":4,"b":0,"r":[["hamzat_wasl",8,9],["ikhfa",13,16],["madd_2",16,17]]},{"t":"يَوْمَئِذٍ تُحَدِّثُ أَخْبَارَهَا","w":3,"b":0,"r":[["ikhfa",9,13]]},{"t":"بِأَنَّ رَبَّكَ أَوْحَىٰ لَهَا","w":4,"b":0,"r":[["ghunnah",4,7]]},{"t":"يَوْمَئِذٍ يَصْدُرُ ٱلنَّاسُ أَشْتَاتًا لِّيُرَوْا۟ أَعْمَٰلَهُمْ","w":6,"b":0,"r":[["idghaam_ghunnah",9,13],["hamzat_wasl",20,21],["lam_shamsiyyah",21,22],["ghunnah",22,25],["idghaam_no_ghunnah",37,43],["silent",49,51],["madd_2",58,59]]},{"t":"فَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ خَيْرًا يَرَهُۥ","w":6,"b":0,"r":[["idghaam_ghunnah",4,8],["idghaam_ghunnah",38,43]]},{"t":"وَمَن يَعْمَلْ مِثْقَالَ ذَرَّةٍ شَرًّا يَرَهُۥ","w":6,"b":0,"r":[["idghaam_ghunnah",4,8],["ikhfa",31,35],["idghaam_ghunnah",37,42]]}]}
