{"surah":69,"ayahs":[{"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلْحَآقَّةُ","w":5,"b":4,"r":[["madd_6",44,46]]},{"t":"مَا ٱلْحَآقَّةُ","w":2,"b":0,"r":[["hamzat_wasl",4,5],["madd_6",9,11]]},{"t":"وَمَآ أَدْرَىٰكَ مَا ٱلْحَآقَّةُ","w":4,"b":0,"r":[["madd_munfasil",4,6],["qalqalah",9,11],["madd_2",14,15],["hamzat_wasl",22,23],["madd_6",27,29]]},{"t":"كَذَّبَتْ ثَمُودُ وَعَادٌۢ بِٱلْقَارِعَةِ","w":4,"b":0,"r":[["iqlab",24,28],["hamzat_wasl",29,30]]},{"t":"فَأَمَّا ثَمُودُ فَأُهْلِكُوا۟ بِٱلطَّاغِيَةِ","w":4,"b":0,"r":[["ghunnah",4,7],["silent",28,30],["hamzat_wasl",33,34],["lam_shamsiyyah",34,35]]},{"t":"وَأَمَّا عَادٌ فَأُهْلِكُوا۟ بِرِيحٍ صَرْصَرٍ عَاتِيَةٍ","w":6,"b":0,"r":[["ghunnah",4,7],["ikhfa",13,17],["silent",26,28],["ikhfa",35,39]]},{"t":"سَخَّرَهَا عَلَيْهِمْ سَبْعَ لَيَالٍ وَثَمَٰنِيَةَ أَيَّامٍ حُسُومًا فَتَرَى ٱلْقَوْمَ فِيهَا صَرْعَىٰ كَأَنَّهُمْ أَعْجَازُ نَخْلٍ خَاوِيَةٍ","w":15,"b":0,"r":[["qalqalah",24,26],["idghaam_ghunnah",35,39],["madd_2",43,44],["ikhfa",66,71],["hamzat_wasl",77,78],["ghunnah",107,110]]},{"t":"فَهَلْ تَرَىٰ لَهُم مِّنۢ بَاقِيَةٍ","w":5,"b":0,"r":[["idghaam_shafawi",18,23],["iqlab",24,27]]},{"t":"وَجَآءَ فِرْعَوْنُ وَمَن قَبْلَهُۥ وَٱلْمُؤْتَفِكَٰتُ بِٱلْخَاطِئَةِ","w":6,"b":0,"r":[["madd_muttasil",4,6],["ikhfa",24,28],["qalqalah",28,30],["madd_2",34,35],["hamzat_wasl",38,39],["madd_2",51,52],["hamzat_wasl",57,58]]},{"t":"فَعَصَوْا۟ رَسُولَ رَبِّهِمْ فَأَخَذَهُمْ أَخْذَةً رَّابِيَةً","w":6,"b":0,"r":[["silent",8,10],["idghaam_no_ghunnah",49,54]]},{"t":"إِنَّا لَمَّا طَغَا ٱلْمَآءُ حَمَلْنَٰكُمْ فِى ٱلْجَارِيَةِ","w":7,"b":0,"r":[["ghunnah",2,5],["ghunnah",9,12],["hamzat_wasl",20,21],["madd_muttasil",25,27],["madd_2",38,39],["hamzat_wasl",48,49]]},{"t":"لِنَجْعَلَهَا لَكُمْ تَذْكِرَةً وَتَعِيَهَآ أُذُنٌ وَٰعِيَةٌ","w":6,"b":0,"r":[["qalqalah",4,6],["idghaam_ghunnah",30,34],["madd_munfasil",42,44],["idghaam_ghunnah",50,54],["madd_2",54,55]]},{"t":"فَإِذَا نُفِخَ فِى ٱلصُّورِ نَفْخَةٌ وَٰحِدَةٌ","w":6,"b":0,"r":[["hamzat_wasl",19,20],["lam_shamsiyyah",20,21],["idghaam_ghunnah",35,39],["madd_2",39,40]]},{"t":"وَحُمِلَتِ ٱلْأَرْضُ وَٱلْجِبَالُ فَدُكَّتَا دَكَّةً وَٰحِدَةً","w":6,"b":0,"r":[["hamzat_wasl",11,12],["hamzat_wasl",23,24],["idghaam_ghunnah",51,55],["madd_2",55,56]]},{"t":"فَيَوْمَئِذٍ وَقَعَتِ ٱلْوَاقِعَةُ","w":3,"b":0,"r":[["idghaam_ghunnah",11,15],["hamzat_wasl",22,23]]},{"t":"وَٱنشَقَّتِ ٱلسَّمَآءُ فَهِىَ يَوْمَئِذٍ وَاهِيَةٌ","w":5,"b":0,"r":[["hamzat_wasl",2,3],["ikhfa",3,6],["hamzat_wasl",12,13],["lam_shamsiyyah",13,14],["madd_muttasil",19,21],["idghaam_ghunnah",40,44]]},{"t":"وَٱلْمَلَكُ عَلَىٰٓ أَرْجَآئِهَا وَيَحْمِلُ عَرْشَ رَبِّكَ فَوْقَهُمْ يَوْمَئِذٍ ثَمَٰنِيَةٌ","w":9,"b":0,"r":[["hamzat_wasl",2,3],["madd_munfasil",16,19],["madd_muttasil",26,28],["ikhfa",80,84],["madd_2",86,87]]},{"t":"يَوْمَئِذٍ تُعْرَضُونَ لَا تَخْفَىٰ مِنكُمْ خَافِيَةٌ","w":6,"b":0,"r":[["ikhfa",9,13],["ikhfa",38,41]]},{"t":"فَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِيَمِينِهِۦ فَيَقُولُ هَآؤُمُ ٱقْرَءُوا۟ كِتَٰبِيَهْ","w":9,"b":0,"r":[["ghunnah",4,7],["madd_2",26,27],["madd_2",31,32],["madd_2",44,45],["madd_muttasil",58,60],["hamzat_wasl",65,66],["qalqalah",66,68],["silent",73,75],["madd_2",80,81]]},{"t":"إِنِّى ظَنَنتُ أَنِّى مُلَٰقٍ حِسَابِيَهْ","w":5,"b":0,"r":[["ghunnah",2,5],["ikhfa",11,14],["ghunnah",17,20],["madd_2",26,27]]},{"t":"فَهُوَ فِى عِيشَةٍ رَّاضِيَةٍ","w":4,"b":0,"r":[["idghaam_no_ghunnah",17,22]]},{"t":"فِى جَنَّةٍ عَالِيَةٍ","w":3,"b":0,"r":[["ghunnah",6,9]]},{"t":"قُطُوفُهَا دَانِيَةٌ","w":2,"b":0,"r":[]},{"t":"كُلُوا۟ وَٱشْرَبُوا۟ هَنِيٓـًٔۢا بِمَآ أَسْلَفْتُمْ فِى ٱلْأَيَّامِ ٱلْخَالِيَةِ","w":8,"b":0,"r":[["silent",5,7],["hamzat_wasl",10,11],["silent",18,20],["madd_muttasil",25,27],["iqlab",29,34],["madd_munfasil",37,39],["hamzat_wasl",57,58],["hamzat_wasl",69,70]]},{"t":"وَأَمَّا مَنْ أُوتِىَ كِتَٰبَهُۥ بِشِمَالِهِۦ فَيَقُولُ يَٰلَيْتَنِى لَمْ أُوتَ كِتَٰبِيَهْ","w":10,"b":0,"r":[["ghunnah",4,7],["madd_2",26,27],["madd_2",31,32],["madd_2",44,45],["madd_2",58,59],["madd_2",8