{"surah":97,"ayahs":[{"t":"بِّسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ إِنَّآ أَنزَلْنَٰهُ فِى لَيْلَةِ ٱلْقَدْرِ","w":9,"b":4,"r":[["ghunnah",42,45],["madd_munfasil",45,47],["ikhfa",50,53],["madd_2",57,58],["hamzat_wasl",74,75],["qalqalah",79,81]]},{"t":"وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ","w":5,"b":0,"r":[["madd_munfasil",4,6],["qalqalah",9,11],["madd_2",14,15],["hamzat_wasl",31,32],["qalqalah",36,38]]},{"t":"لَيْلَةُ ٱلْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ","w":6,"b":0,"r":[["hamzat_wasl",9,10],["qalqalah",14,16],["idghaam_ghunnah",24,29]]},{"t":"تَنَزَّلُ ٱلْمَلَٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ","w":9,"b":0,"r":[["hamzat_wasl",10,11],["madd_muttasil",17,19],["hamzat_wasl",28,29],["lam_shamsiyyah",29,30],["idghaam_shafawi",60,65],["ikhfa",65,69]]},{"t":"سَلَٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ","w":5,"b":0,"r":[["madd_2",4,5],["qalqalah",23,25],["hamzat_wasl",30,31],["qalqalah",35,37]]}]}
