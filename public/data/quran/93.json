{"surah":93,"ayahs":[{"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلضُّحَىٰ","w":5,"b":4,"r":[["hamzat_wasl",41,42],["lam_shamsiyyah",42,43]]},{"t":"وَٱلَّيْلِ إِذَا سَجَىٰ","w":3,"b":0,"r":[["hamzat_wasl",2,3]]},{"t":"مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ","w":5,"b":0,"r":[]},{"t":"وَلَلْءَاخِرَةُ خَيْرٌ لَّكَ مِنَ ٱلْأُولَىٰ","w":5,"b":0,"r":[["idghaam_no_ghunnah",21,26],["hamzat_wasl",34,35]]},{"t":"وَلَسَوْفَ يُعْطِيكَ رَبُّكَ فَتَرْضَىٰٓ","w":4,"b":0,"r":[]},{"t":"أَلَمْ يَجِدْكَ يَتِيمًا فَـَٔاوَىٰ","w":4,"b":0,"r":[["qalqalah",11,13],["ikhfa",22,27]]},{"t":"وَوَجَدَكَ ضَآلًّا فَهَدَىٰ","w":3,"b":0,"r":[["madd_6",13,15],["ikhfa",17,22]]},{"t":"وَوَجَدَكَ عَآئِلًا فَأَغْنَىٰ","w":3,"b":0,"r":[["madd_muttasil",13,15],["ikhfa",18,23]]},{"t":"فَأَمَّا ٱلْيَتِيمَ فَلَا تَقْهَرْ","w":4,"b":0,"r":[["ghunnah",4,7],["hamzat_wasl",9,10],["qalqalah",28,30]]},{"t":"وَأَمَّا ٱلسَّآئِلَ فَلَا تَنْهَرْ","w":4,"b":0,"r":[["ghunnah",4,7],["hamzat_wasl",9,10],["lam_shamsiyyah",10,11],["madd_muttasil",14,16]]},{"t":"وَأَمَّا بِنِعْمَةِ رَبِّكَ فَحَدِّثْ","w":4,"b":0,"r":[["ghunnah",4,7]]}]}
