{"surah":91,"ayahs":[{"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلشَّمْسِ وَضُحَىٰهَا","w":6,"b":4,"r":[["hamzat_wasl",41,42],["lam_shamsiyyah",42,43],["madd_2",58,59]]},{"t":"وَٱلْقَمَرِ إِذَا تَلَىٰهَا","w":3,"b":0,"r":[["hamzat_wasl",2,3],["madd_2",23,24]]},{"t":"وَٱلنَّهَارِ إِذَا جَلَّىٰهَا","w":3,"b":0,"r":[["hamzat_wasl",2,3],["lam_shamsiyyah",3,4],["ghunnah",4,7],["madd_2",25,26]]},{"t":"وَٱلَّيْلِ إِذَا يَغْشَىٰهَا","w":3,"b":0,"r":[["hamzat_wasl",2,3],["madd_2",24,25]]},{"t":"وَٱلسَّمَآءِ وَمَا بَنَىٰهَا","w":3,"b":0,"r":[["hamzat_wasl",2,3],["lam_shamsiyyah",3,4],["madd_muttasil",9,11],["madd_2",25,26]]},{"t":"وَٱلْأَرْضِ وَمَا طَحَىٰهَا","w":3,"b":0,"r":[["hamzat_wasl",2,3],["madd_2",23,24]]},{"t":"وَنَفْسٍ وَمَا سَوَّىٰهَا","w":3,"b":0,"r":[["idghaam_ghunnah",7,11],["madd_2",21,22]]},{"t":"فَأَلْهَمَهَا فُجُورَهَا وَتَقْوَىٰهَا","w":3,"b":0,"r":[["qalqalah",29,31],["madd_2",34,35]]},{"t":"قَدْ أَفْلَحَ مَن زَكَّىٰهَا","w":4,"b":0,"r":[["qalqalah",2,4],["ikhfa",16,20],["madd_2",24,25]]},{"t":"وَقَدْ خَابَ مَن دَسَّىٰهَا","w":4,"b":0,"r":[["qalqalah",4,6],["ikhfa",15,19],["madd_2",23,24]]},{"t":"كَذَّبَتْ ثَمُودُ بِطَغْوَىٰهَآ","w":3,"b":0,"r":[["madd_2",27,28]]},{"t":"إِذِ ٱنۢبَعَثَ أَشْقَىٰهَا","w":3,"b":0,"r":[["hamzat_wasl",5,6],["iqlab",7,9],["madd_2",22,23]]},{"t":"فَقَالَ لَهُمْ رَسُولُ ٱللَّهِ نَاقَةَ ٱللَّهِ وَسُقْيَٰهَا","w":7,"b":0,"r":[["hamzat_wasl",23,24],["hamzat_wasl",39,40],["qalqalah",51,53],["madd_2",55,56]]},{"t":"فَكَذَّبُوهُ فَعَقَرُوهَا فَدَمْدَمَ عَلَيْهِمْ رَبُّهُم بِذَنۢبِهِمْ فَسَوَّىٰهَا","w":7,"b":0,"r":[["ikhfa_shafawi",55,59],["iqlab",62,64],["madd_2",78,79]]},{"t":"وَلَا يَخَافُ عُقْبَٰهَا","w":3,"b":0,"r":[["qalqalah",16,18],["madd_2",20,21]]}]}
