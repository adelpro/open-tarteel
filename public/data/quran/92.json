{"surah":92,"ayahs":[{"t":"بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ وَٱلَّيْلِ إِذَا يَغْشَىٰ","w":7,"b":4,"r":[["hamzat_wasl",41,42]]},{"t":"وَٱلنَّهَارِ إِذَا تَجَلَّىٰ","w":3,"b":0,"r":[["hamzat_wasl",2,3],["lam_shamsiyyah",3,4],["ghunnah",4,7]]},{"t":"وَمَا خَلَقَ ٱلذَّكَرَ وَٱلْأُنثَىٰٓ","w":4,"b":0,"r":[["hamzat_wasl",13,14],["lam_shamsiyyah",14,15],["hamzat_wasl",25,26],["ikhfa",30,33]]},{"t":"إِنَّ سَعْيَكُمْ لَشَتَّىٰ","w":3,"b":0,"r":[["ghunnah",2,5]]},{"t":"فَأَمَّا مَنْ أَعْطَىٰ وَٱتَّقَىٰ","w":4,"b":0,"r":[["ghunnah",4,7],["hamzat_wasl",25,26]]},{"t":"وَصَدَّقَ بِٱلْحُسْنَىٰ","w":2,"b":0,"r":[["hamzat_wasl",12,13]]},{"t":"فَسَنُيَسِّرُهُۥ لِلْيُسْرَىٰ","w":2,"b":0,"r":[["madd_2",15,16]]},{"t":"وَأَمَّا مَنۢ بَخِلَ وَٱسْتَغْنَىٰ","w":4,"b":0,"r":[["ghunnah",4,7],["iqlab",12,15],["hamzat_wasl",23,24]]},{"t":"وَكَذَّبَ بِٱلْحُسْنَىٰ","w":2,"b":0,"r":[["hamzat_wasl",12,13]]},{"t":"فَسَنُيَسِّرُهُۥ لِلْعُسْرَىٰ","w":2,"b":0,"r":[["madd_2",15,16]]},{"t":"وَمَا يُغْنِى عَنْهُ مَالُهُۥٓ إِذَا تَرَدَّىٰٓ","w":6,"b":0,"r":[["madd_munfasil",28,30]]},{"t":"إِنَّ عَلَيْنَا لَلْهُدَىٰ","w":3,"b":0,"r":[["ghunnah",2,5]]},{"t":"وَإِنَّ لَنَا لَلْءَاخِرَةَ وَٱلْأُولَىٰ","w":4,"b":0,"r":[["ghunnah",4,7],["hamzat_wasl",30,31]]},{"t":"فَأَنذَرْتُكُمْ نَارًا تَلَظَّىٰ","w":3,"b":0,"r":[["ikhfa",4,7],["ikhfa",20,25]]},{"t":"لَا يَصْلَىٰهَآ إِلَّا ٱلْأَشْقَى","w":4,"b":0,"r":[["madd_2",11,12],["madd_munfasil",14,16],["hamzat_wasl",24,25]]},{"t":"ٱلَّذِى كَذَّبَ وَتَوَلَّىٰ","w":3,"b":0,"r":[]},{"t":"وَسَيُجَنَّبُهَا ٱلْأَتْقَى","w":2,"b":0,"r":[["ghunnah",8,11],["hamzat_wasl",17,18]]},{"t":"ٱلَّذِى يُؤْتِى مَالَهُۥ يَتَزَكَّىٰ","w":4,"b":0,"r":[["madd_2",23,24]]},{"t":"وَمَا لِأَحَدٍ عِندَهُۥ مِن نِّعْمَةٍ تُجْزَىٰٓ","w":6,"b":0,"r":[["ikhfa",17,20],["madd_2",22,23],["idghaam_ghunnah",26,31],["ikhfa",36,40],["qalqalah",40,42]]},{"t":"إِلَّا ٱبْتِغَآءَ وَجْهِ رَبِّهِ ٱلْأَعْلَىٰ","w":5,"b":0,"r":[["hamzat_wasl",7,8],["qalqalah",8,10],["madd_muttasil",14,16],["qalqalah",21,23],