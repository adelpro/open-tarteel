# Cloudflare Pages test deploy — copy to .env.cloudflare and fill in secrets.
# IMPORTANT: do not link a quran.us.kg hostname yet. Use the *.pages.dev URL.

# ── Project / deployment ─────────────────────────────────────────────────────
# Cloudflare Pages project name. Must be unique in your account.
CF_PROJECT_NAME=open-tarteel-cf-test
# Public URL Cloudflare assigns to the project (no custom domain yet).
NEXT_PUBLIC_APP_URL=https://open-tarteel-cf-test.pages.dev
# Tells next.config to skip `output: standalone` for OpenNext builds.
CF_BUILD=true
# Test deploy must not compete with the real site in search results.
SEO_NOINDEX=true
# Auto-activate the new worker on each preview instead of waiting for promotion.
NEXT_PUBLIC_IS_PREVIEW=true

# ── App identity ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Open Tarteel
NEXT_PUBLIC_APP_VERSION=N/A
NEXT_PUBLIC_DEBUG=false

# ── Feature flags (same defaults as .env.example) ───────────────────────────
NEXT_PUBLIC_ENABLE_MP3QURAN_V4=false
NEXT_PUBLIC_ENABLE_FOLLOW_ALONG=false

# ── Optional services ───────────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
FEED_BACK_EMAIL=
FEED_BACK_PASSWORD=
FEED_BACK_SERVICE=
FEED_BACK_HOST=
FEED_BACK_PORT=

# ── Wrangler credentials (NEVER commit real values) ─────────────────────────
# For local testing prefer `npx wrangler login` and leave these empty.
# For CI, use a scoped API token: Workers Scripts:Edit + Cloudflare Pages:Edit.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
